{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["ES2017", "dom"],
    "sourceMap": true,
    "types": ["cypress", "node"],
    "allowJs": true,
    "isolatedModules": false,
    "rootDir": "..",
    "outDir": "./dist",
    "module": "Node16",
    "moduleResolution": "node16",
  },
  "include": ["**/*.ts", "**/*.tsx", "../cypress.config.ts"],
}
